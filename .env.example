# Authorized data root for both compression and extraction; must already exist.
# Empty/unset: read the current user's saved setting from `betterzip-mcp setup`.
# Without either setting, tools request setup and grant no directory access.
# Tool calls cannot expand this root. No installation-directory fallback is used.
# .mcp.json forwards this variable from the Codex process through env_vars.
BETTERZIP_MCP_ROOT=

# Trusted absolute path to BetterZip's bundled 7za, used for archive operations.
# Empty/unset: try /Applications/BetterZip.app/Contents/Helpers/7za, then ~/Applications.
# .mcp.json also forwards this variable; no model/API-key variables are forwarded.
BETTERZIP_MCP_7ZA=

# User settings: os.UserConfigDir()/betterzip-mcp/config.json, containing only root.
# settings.example.json shows the format; project-local files are not auto-loaded.
# This file is documentation only; the server does not automatically load .env files.
# Timeout and byte limits are CLI flags: --timeout=5m --max-bytes=4294967296.
